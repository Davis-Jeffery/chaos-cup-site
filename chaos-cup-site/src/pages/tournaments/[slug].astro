---
/**
 * Tournament page. Status (from src/lib/status.ts) picks the layout:
 * - upcoming / live: TurkeyTakedown.dc.html layout (live swaps the register box for standings)
 * - postponed / cancelled: same layout with a notice, registration hidden
 * - past: MonsterMash.dc.html recap layout
 */
import Layout from '../../layouts/Layout.astro';
import EventHero from '../../components/tournament/EventHero.astro';
import RegisterPanel from '../../components/tournament/RegisterPanel.astro';
import EventDetails from '../../components/tournament/EventDetails.astro';
import PhotoStrip from '../../components/tournament/PhotoStrip.astro';
import Recap from '../../components/tournament/Recap.astro';
import { sanityFetch } from '../../lib/sanity';
import { activeSponsors, getLayoutData } from '../../lib/site';
import { getStatus, nowForRequest } from '../../lib/status';
import { cityFromAddress, dateRange } from '../../lib/format';
import { urlFor } from '../../lib/sanity';
import { currentPrice } from '../../lib/status';
import { stegaClean } from '@sanity/client/stega';
import { ALL_TOURNAMENTS_QUERY, bundlePartner, currentAndUpcoming, type Tournament } from '../../lib/tournaments';

const { slug } = Astro.params;
const preview = Astro.locals.preview;
const now = nowForRequest(Astro.url, { preview });

const [data, tournaments] = await Promise.all([getLayoutData(preview), sanityFetch<Tournament[]>(ALL_TOURNAMENTS_QUERY, { preview })]);
const t = tournaments.find((x) => x.slug === slug);
if (!t) return Astro.rewrite('/404');

const status = getStatus(t, now);
const isPast = status === 'past';
const halted = status === 'postponed' || status === 'cancelled';
const photoPartner = activeSponsors(data.sponsors, now).find((s) => /photo sharing partner/i.test(s.designation ?? ''));
const nextEvent = currentAndUpcoming(tournaments, now).find((x) => x._id !== t._id);
const bundleWith = bundlePartner(t, tournaments, now);

// schema.org event data so search engines can show dates, venue and price.
const eventImage = t.cardImage ?? t.heroImage ?? t.recap?.coverImage;
const price = currentPrice(t, now);
const jsonLd = stegaClean({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${t.title} | ${t.presentingSponsorName ? `${t.presentingSponsorName} ` : ''}Chaos Cup 3v3`,
  sport: 'Soccer',
  startDate: t.startDate,
  endDate: t.endDate || t.startDate,
  eventStatus: `https://schema.org/${
    status === 'cancelled' ? 'EventCancelled' : status === 'postponed' ? 'EventPostponed' : 'EventScheduled'
  }`,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
  ...(eventImage?.asset ? { image: [urlFor(eventImage).width(1200).url()] } : {}),
  ...(t.venue?.name
    ? { location: { '@type': 'Place', name: t.venue.name, ...(t.venue.address ? { address: t.venue.address } : {}) } }
    : {}),
  organizer: { '@type': 'Organization', name: 'Atomic Athletics', url: (Astro.site ?? Astro.url).origin },
  ...(price != null && !isPast && !halted
    ? {
        offers: {
          '@type': 'Offer',
          price: price.toFixed(2),
          priceCurrency: 'USD',
          url: t.links?.registerUrl || data.settings.registerUrl,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
});

const vars = `--event: ${t.primaryColor}; --event-accent: ${t.accentColor || t.primaryColor}`;
const city = cityFromAddress(t.venue?.address);
const title =
  t.seo?.title || (isPast ? `${t.title} Photos and Results` : city ? `${t.title}: 3v3 Soccer in ${city}` : `${t.title}: 3v3 Soccer`);
const description =
  t.seo?.description ||
  (isPast
    ? `Photos and results from the ${t.title}, ${dateRange(t.startDate, t.endDate)}${t.venue?.name ? ` at ${t.venue.name}` : ''}.`
    : `${t.title}: 3v3 youth soccer inside inflatable walled fields, ${dateRange(t.startDate, t.endDate)}${t.venue?.name ? ` at ${t.venue.name}` : ''}. Ages ${t.divisions ?? 'U7 to U18'}.`);
---

<Layout
  data={data}
  now={now}
  title={title}
  description={description}
  ogImage={t.seo?.image ?? t.cardImage ?? t.recap?.coverImage}
  currentTournamentId={t._id}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {
    isPast ? (
      <Recap tournament={t} nextEvent={nextEvent} photoPartner={photoPartner} now={now} defaultRegisterUrl={data.settings.registerUrl} />
    ) : (
      <div style={vars}>
        <EventHero tournament={t} />
        <section class="ev-section">
          <div class="wrap">
            {halted && (
              <div class="notice" role="status">
                <span class="eyebrow notice-label">{status === 'cancelled' ? 'Cancelled' : 'Postponed'}</span>
                <p>
                  {t.overrideNote ||
                    (status === 'cancelled'
                      ? `The ${t.title} has been cancelled.`
                      : `The ${t.title} has been postponed. New dates are coming soon.`)}
                </p>
              </div>
            )}
            <div class="ev-layout">
              <RegisterPanel
                tournament={t}
                status={status}
                now={now}
                defaultRegisterUrl={data.settings.registerUrl}
                defaultSoloUrl={data.settings.individualSignupUrl}
                bundleWith={bundleWith}
              />
              <EventDetails tournament={t} />
            </div>
          </div>
        </section>
        <PhotoStrip items={t.photoStrip} photoPartner={photoPartner} />
      </div>
    )
  }
</Layout>

<style>
  .ev-section {
    padding: 56px 0 112px;
  }
  .ev-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
  }
  .notice {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 28px;
    margin-bottom: 40px;
    border-radius: 20px;
    background: #2a1414;
    border: 2px solid #ff6b6b;
  }
  .notice-label {
    color: #ff6b6b;
  }
  .notice p {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
  }
</style>
