---
import Layout from '../layouts/Layout.astro';
import { getLayoutData } from '../lib/site';
import { nowForRequest } from '../lib/status';

Astro.response.status = 404;
const now = nowForRequest(Astro.url);
const data = await getLayoutData();
---

<Layout data={data} now={now} title="Page not found" hideSponsors>
  <section style="padding: 128px 0">
    <div class="wrap" style="display: flex; flex-direction: column; align-items: flex-start; gap: 24px">
      <span class="eyebrow" style="color: var(--magenta)">404</span>
      <h1 style="font-size: clamp(44px, 7vw, 96px)">Out of <span style="color: var(--magenta)">bounds.</span></h1>
      <p style="font-size: 19px; color: var(--muted); max-width: 560px; line-height: 1.55">
        We couldn't find that page. The ball never goes out at the Chaos Cup, but this link did.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 14px">
        <a class="btn btn-pink" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href="/#tournaments">See tournaments</a>
      </div>
    </div>
  </section>
</Layout>
