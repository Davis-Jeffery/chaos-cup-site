---
/**
 * Shared page shell: head (fonts, SEO), header, page content, sponsors and footer.
 *
 * Pages fetch the layout data once with getLayoutData() and pass it in, so the
 * same `now` (including the ?date= preview override) drives the whole page.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sponsors from '../components/Sponsors.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { stegaClean } from '@sanity/client/stega';
import { urlFor } from '../lib/sanity';
import type { LayoutData } from '../lib/site';

interface Props {
  data: LayoutData;
  now: Date;
  /** Page title. The site name is added unless the title already has it. */
  title?: string;
  description?: string;
  /** Sanity image for Open Graph. Falls back to the site default. */
  ogImage?: any;
  footer?: 'full' | 'compact';
  /** Hide the sponsors section (it shows on every page by default). */
  hideSponsors?: boolean;
  currentTournamentId?: string;
}

const { data, now, title, description, ogImage, footer = 'compact', hideSponsors = false, currentTournamentId } =
  Astro.props;
const { settings } = data;

const preview = Astro.locals.preview;
const siteName = 'Chaos Cup';
// Preview text carries invisible click-to-edit markers; keep them out of <head>.
const cleanTitle = stegaClean(title);
const seoTitle = stegaClean(settings.seoTitle);
const fullTitle = !cleanTitle ? (seoTitle ?? siteName) : cleanTitle.includes(siteName) ? cleanTitle : `${cleanTitle} | ${siteName}`;
const metaDescription = stegaClean(description ?? settings.seoDescription);
const shareImage = ogImage?.asset ? ogImage : settings.seoImage;
const shareImageUrl = shareImage?.asset ? urlFor(shareImage).width(1200).height(630).fit('crop').url() : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A0A12" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonical} />
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    {shareImageUrl && <meta property="og:image:width" content="1200" />}
    {shareImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700;800&display=swap"
    />
    {preview && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="before-header" />
    <Header settings={settings} />
    <main id="main">
      <slot />
      {!hideSponsors && <Sponsors data={data} now={now} currentTournamentId={currentTournamentId} />}
      <slot name="after-sponsors" />
    </main>
    <Footer settings={settings} variant={footer} />
    {
      preview && (
        <div class="preview-bar" data-preview-bar>
          <span class="preview-dot" aria-hidden="true" />
          <span>Preview: showing drafts</span>
          <a href={`/api/draft-mode/disable?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}>Exit preview</a>
        </div>
      )
    }
    <VisualEditing enabled={preview} zIndex={1000} />
  </body>
</html>

<style>
  .preview-bar {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--text);
    color: var(--ink);
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
  }
  .preview-bar a {
    color: var(--ink);
    font-weight: 800;
  }
  .preview-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--magenta);
  }
</style>

<script>
  // Inside the Studio's Presentation tool the Studio shows its own controls.
  if (window.self !== window.top) document.querySelector('[data-preview-bar]')?.remove();
</script>
