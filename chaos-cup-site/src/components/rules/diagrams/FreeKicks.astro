// Copied verbatim from design-reference/Rulebook.dc.html. Edit the SVG here, not in Sanity.
---
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; max-width: 860px; margin: 4px 0 12px 80px" class="rule-figs">
<figure style="margin: 0; border: 2px solid #3CA8E4; border-radius: 18px; padding: 16px; display: flex; flex-direction: column; gap: 12px; background: #0F0F19">
<svg role="img" aria-label="Indirect free kick" viewBox="0 0 400 240" style="width: 100%; height: auto; display: block; background: #0E2A1C; border-radius: 14px">
<rect x="4" y="4" width="392" height="232" rx="18" fill="none" stroke="#2D5A44" stroke-width="6"></rect>
<line x1="200" y1="10" x2="200" y2="230" stroke="#4E7F66" stroke-width="2" stroke-dasharray="6 6"></line>
<path d="M388 74 A46 46 0 0 0 388 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
<path d="M12 74 A46 46 0 0 1 12 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
<rect x="388" y="98" width="8" height="44" fill="#F4F3F8"></rect><rect x="4" y="98" width="8" height="44" fill="#F4F3F8"></rect>
<circle cx="290" cy="120" r="5.5" fill="#F5D90A" stroke="#0A0A12" stroke-width="1.5"></circle><circle cx="290" cy="120" r="34" fill="none" stroke="#F4F3F8" stroke-width="2.5" stroke-dasharray="4 4"></circle><text x="290" y="74" fill="#F4F3F8" font-family="Archivo, sans-serif" font-size="12" font-weight="700" text-anchor="middle">3 yards</text><circle cx="280" cy="120" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle><circle cx="310" cy="175" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle><line x1="296" y1="124" x2="308.1" y2="155.7" stroke="#F5D90A" stroke-width="2.5"></line><path d="M312 166 L313.2 153.8 L302.9 157.7 Z" fill="#F5D90A"></path><line x1="318" y1="168" x2="374.6" y2="133.7" stroke="#F5D90A" stroke-width="2.5"></line><path d="M384 128 L371.7 129.0 L377.4 138.4 Z" fill="#F5D90A"></path><circle cx="340" cy="92" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle><circle cx="240" cy="150" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle><circle cx="342" cy="152" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
</svg>
<figcaption style="display: flex; flex-direction: column; gap: 8px">
<span style="display: inline-flex; align-self: flex-start; background: #3CA8E4; color: #0A0A12; font-weight: 800; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px">Legal</span>
<span style="font-family: 'Archivo Black', sans-serif; font-size: 20px; color: #F4F3F8">Indirect free kick</span>
<span style="color: #C9C8D8; font-size: 15px; line-height: 1.5">Free kicks are indirect. The ball must touch a second player before a goal counts. Defenders give 3 yards.</span>
<span style="color: #3CA8E4; font-weight: 800; font-size: 14px">Pass first, then shoot</span>
</figcaption>
</figure>
<figure style="margin: 0; border: 2px solid #FF6B6B; border-radius: 18px; padding: 16px; display: flex; flex-direction: column; gap: 12px; background: #0F0F19">
<svg role="img" aria-label="Shooting straight from a free kick" viewBox="0 0 400 240" style="width: 100%; height: auto; display: block; background: #0E2A1C; border-radius: 14px">
<rect x="4" y="4" width="392" height="232" rx="18" fill="none" stroke="#2D5A44" stroke-width="6"></rect>
<line x1="200" y1="10" x2="200" y2="230" stroke="#4E7F66" stroke-width="2" stroke-dasharray="6 6"></line>
<path d="M388 74 A46 46 0 0 0 388 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
<path d="M12 74 A46 46 0 0 1 12 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
<rect x="388" y="98" width="8" height="44" fill="#F4F3F8"></rect><rect x="4" y="98" width="8" height="44" fill="#F4F3F8"></rect>
<circle cx="280" cy="120" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle><circle cx="292" cy="120" r="5.5" fill="#F5D90A" stroke="#0A0A12" stroke-width="1.5"></circle><circle cx="290" cy="120" r="34" fill="none" stroke="#F4F3F8" stroke-width="2.5" stroke-dasharray="4 4"></circle><line x1="298" y1="120" x2="373.0" y2="120.0" stroke="#F5D90A" stroke-width="2.5"></line><path d="M384 120 L373.0 114.5 L373.0 125.5 Z" fill="#F5D90A"></path><line x1="363" y1="97" x2="377" y2="111" stroke="#FF6B6B" stroke-width="3.5" stroke-linecap="round"></line><line x1="377" y1="97" x2="363" y2="111" stroke="#FF6B6B" stroke-width="3.5" stroke-linecap="round"></line><circle cx="340" cy="90" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle><circle cx="240" cy="160" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle><circle cx="346" cy="158" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
</svg>
<figcaption style="display: flex; flex-direction: column; gap: 8px">
<span style="display: inline-flex; align-self: flex-start; background: #FF6B6B; color: #0A0A12; font-weight: 800; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px">No goal</span>
<span style="font-family: 'Archivo Black', sans-serif; font-size: 20px; color: #F4F3F8">Shooting straight from a free kick</span>
<span style="color: #C9C8D8; font-size: 15px; line-height: 1.5">A free kick that goes straight into the goal without touching anyone else does not count.</span>
<span style="color: #FF6B6B; font-weight: 800; font-size: 14px">No goal. Goal kick for the defense.</span>
</figcaption>
</figure>
</div>
