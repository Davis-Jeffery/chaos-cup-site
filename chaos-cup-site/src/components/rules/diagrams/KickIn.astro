<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; max-width: 420px; margin: 4px 0 12px 80px" class="rule-figs">
<figure style="margin: 0; border: 2px solid #3CA8E4; border-radius: 18px; padding: 16px; display: flex; flex-direction: column; gap: 12px; background: #0F0F19">
<svg role="img" aria-label="Ball over the wall" viewBox="0 0 400 240" style="width: 100%; height: auto; display: block; background: #0E2A1C; border-radius: 14px">
<rect x="4" y="4" width="392" height="232" rx="18" fill="none" stroke="#2D5A44" stroke-width="6"></rect>
<line x1="200" y1="10" x2="200" y2="230" stroke="#4E7F66" stroke-width="2" stroke-dasharray="6 6"></line>
<path d="M388 74 A46 46 0 0 0 388 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
<path d="M12 74 A46 46 0 0 1 12 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
<rect x="388" y="98" width="8" height="44" fill="#F4F3F8"></rect><rect x="4" y="98" width="8" height="44" fill="#F4F3F8"></rect>
<circle cx="150" cy="70" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle><line x1="158" y1="62" x2="213.7" y2="13.2" stroke="#F5D90A" stroke-width="2.5" stroke-dasharray="5 4"></line><path d="M222 6 L210.1 9.1 L217.3 17.4 Z" fill="#F5D90A"></path><path d="M196 7 A30 30 0 0 0 256 7" fill="none" stroke="#F4F3F8" stroke-width="2" stroke-dasharray="4 4"></path><text x="272" y="30" fill="#F4F3F8" font-family="Archivo, sans-serif" font-size="11" font-weight="700">3 ft</text><circle cx="226" cy="12" r="9" fill="none" stroke="#F5D90A" stroke-width="2.5"></circle><text x="226" y="34" fill="#F5D90A" font-family="Archivo, sans-serif" font-size="12" font-weight="700" text-anchor="middle">went out here</text><circle cx="226" cy="20" r="5.5" fill="#F5D90A" stroke="#0A0A12" stroke-width="1.5"></circle><circle cx="250" cy="60" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle><line x1="232" y1="26" x2="239.4" y2="42.0" stroke="#3CA8E4" stroke-width="2.5"></line><path d="M244 52 L244.4 39.7 L234.4 44.3 Z" fill="#3CA8E4"></path><circle cx="300" cy="150" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle><circle cx="120" cy="170" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
</svg>
<figcaption style="display: flex; flex-direction: column; gap: 8px">
<span style="display: inline-flex; align-self: flex-start; background: #3CA8E4; color: #0A0A12; font-weight: 800; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px">Kick-in</span>
<span style="font-family: 'Archivo Black', sans-serif; font-size: 20px; color: #F4F3F8">Ball over the wall</span>
<span style="color: #C9C8D8; font-size: 15px; line-height: 1.5">White kicks the ball out over the wall. Blue restarts with an indirect kick-in from the spot where it went out. White stays at least 3 feet away until the ball is kicked.</span>
<span style="color: #3CA8E4; font-weight: 800; font-size: 14px">Blue kick-in from that spot. Indirect, 3 feet back.</span>
</figcaption>
</figure>
</div>
