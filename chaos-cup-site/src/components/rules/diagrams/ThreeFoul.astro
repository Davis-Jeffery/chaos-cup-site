---
/**
 * The 3-foul free kick (rules group "3-foul rule" + "Taking the 3-foul free kick"),
 * drawn from design-reference/Rulebook.dc.html and animated.
 *
 * 1. Setup (9s loop): White's 3rd foul, then everyone walks to the halfway line,
 *    5 feet from the shooter, and the attacking half opens up.
 * 2. Live (7s loop): the shooter kicks, and everyone chases the ball.
 *
 * Every piece is drawn where the design puts it and animated in from an offset,
 * so the reduced-motion still frame (and the end of each loop) matches the design.
 * Edit the SVG here, not in Sanity.
 */
---

<div class="tf" data-anim>
  <div class="tf-grid">
    <figure class="tf-fig">
      <svg role="img" aria-label="Animation. After White's 3rd foul, every player walks to the halfway line and lines up at least 5 feet from the Blue shooter, who has the ball on the halfway line. The whole attacking half is open." viewBox="0 0 400 240" class="tf-svg tf-setup">
        <rect x="4" y="4" width="392" height="232" rx="18" fill="none" stroke="#2D5A44" stroke-width="6"></rect>
        <line x1="200" y1="10" x2="200" y2="230" stroke="#4E7F66" stroke-width="2" stroke-dasharray="6 6"></line>
        <path d="M388 74 A46 46 0 0 0 388 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
        <path d="M12 74 A46 46 0 0 1 12 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
        <rect x="388" y="98" width="8" height="44" fill="#F4F3F8"></rect><rect x="4" y="98" width="8" height="44" fill="#F4F3F8"></rect>
        <g class="s-scene">
          <rect class="s-open" x="200" y="7" width="186" height="226" fill="rgba(60,168,228,0.08)"></rect>
          <g class="s-arc">
            <path d="M200 82 A38 38 0 0 0 200 158" fill="none" stroke="#F4F3F8" stroke-width="2" stroke-dasharray="4 4"></path>
            <text x="176" y="124" fill="#F4F3F8" font-family="Archivo, sans-serif" font-size="12" font-weight="700" text-anchor="middle">5 ft</text>
          </g>
          <circle class="s-shooter" cx="200" cy="120" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle>
          <circle cx="212" cy="120" r="5.5" fill="#F5D90A" stroke="#0A0A12" stroke-width="1.5"></circle>
          <g class="s-shot">
            <line x1="220" y1="120" x2="373.0" y2="120.0" stroke="#F5D90A" stroke-width="2.5" stroke-dasharray="6 5"></line>
            <path d="M384 120 L373.0 114.5 L373.0 125.5 Z" fill="#F5D90A"></path>
          </g>
          <circle class="s-p1" cx="188" cy="22" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
          <circle class="s-p2" cx="188" cy="48" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle>
          <circle class="s-p3" cx="188" cy="74" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
          <circle class="s-p4" cx="188" cy="166" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle>
          <circle class="s-p5" cx="188" cy="192" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
          <text class="s-open-label" x="293" y="40" fill="#7CC4EC" font-family="Archivo, sans-serif" font-size="12" font-weight="700" text-anchor="middle">Open field</text>
          <g class="s-lineup" fill="#F4F3F8" font-family="Archivo, sans-serif" font-size="12" font-weight="700" text-anchor="middle">
            <text x="96" y="116">Everyone lines up</text>
            <text x="96" y="132">at half, 5 ft back</text>
          </g>
          <g class="s-foul" font-family="Archivo, sans-serif" font-weight="700" text-anchor="middle">
            <text x="200" y="214" fill="#F5D90A" font-size="13">Whistle: White's 3rd foul</text>
          </g>
        </g>
      </svg>
      <figcaption>
        <span class="tf-badge">3rd foul: setup</span>
        <span class="tf-title">Lining up the 3-foul free kick</span>
        <span class="tf-text">The shooter stands on the halfway line with the ball. Every other player, from both teams, lines up at half at least 5 feet from the shooter.</span>
        <span class="tf-sum">The whole attacking half is open</span>
      </figcaption>
    </figure>

    <figure class="tf-fig">
      <svg role="img" aria-label="Animation. The Blue shooter kicks the ball from the halfway line. The moment it is kicked, players from both teams chase it and regular play continues." viewBox="0 0 400 240" class="tf-svg tf-live">
        <rect x="4" y="4" width="392" height="232" rx="18" fill="none" stroke="#2D5A44" stroke-width="6"></rect>
        <line x1="200" y1="10" x2="200" y2="230" stroke="#4E7F66" stroke-width="2" stroke-dasharray="6 6"></line>
        <path d="M388 74 A46 46 0 0 0 388 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
        <path d="M12 74 A46 46 0 0 1 12 166 Z" fill="rgba(249,14,231,0.14)" stroke="#F90EE7" stroke-width="2" stroke-dasharray="7 5"></path>
        <rect x="388" y="98" width="8" height="44" fill="#F4F3F8"></rect><rect x="4" y="98" width="8" height="44" fill="#F4F3F8"></rect>
        <g class="l-scene">
          <circle class="l-shooter" cx="200" cy="120" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle>
          <g class="l-trail">
            <line x1="212" y1="120" x2="305.0" y2="114.6" stroke="#F5D90A" stroke-width="2.5" stroke-dasharray="6 5"></line>
            <path d="M316 114 L304.7 109.1 L305.3 120.1 Z" fill="#F5D90A"></path>
          </g>
          <circle class="l-ball" cx="212" cy="120" r="5.5" fill="#F5D90A" stroke="#0A0A12" stroke-width="1.5"></circle>
          <circle class="l-ring" cx="322" cy="114" r="10" fill="none" stroke="#F5D90A" stroke-width="2.5"></circle>
          <g class="l-trail">
            <line x1="196" y1="80" x2="239.7" y2="96.2" stroke="#F4F3F8" stroke-width="2.5" stroke-dasharray="4 4"></line><path d="M250 100 L241.6 91.0 L237.8 101.3 Z" fill="#F4F3F8"></path>
            <line x1="196" y1="52" x2="251.8" y2="74.0" stroke="#3CA8E4" stroke-width="2.5" stroke-dasharray="4 4"></line><path d="M262 78 L253.8 68.9 L249.7 79.1 Z" fill="#3CA8E4"></path>
            <line x1="196" y1="160" x2="251.2" y2="148.3" stroke="#3CA8E4" stroke-width="2.5" stroke-dasharray="4 4"></line><path d="M262 146 L250.1 142.9 L252.4 153.7 Z" fill="#3CA8E4"></path>
            <line x1="196" y1="186" x2="239.9" y2="166.5" stroke="#F4F3F8" stroke-width="2.5" stroke-dasharray="4 4"></line><path d="M250 162 L237.7 161.4 L242.2 171.5 Z" fill="#F4F3F8"></path>
          </g>
          <circle class="l-p3" cx="188" cy="74" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
          <circle class="l-p2" cx="188" cy="48" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle>
          <circle class="l-p4" cx="188" cy="166" r="10" fill="#3CA8E4" stroke="#0A0A12" stroke-width="2"></circle>
          <circle class="l-p5" cx="188" cy="192" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
          <circle cx="188" cy="22" r="10" fill="#F4F3F8" stroke="#0A0A12" stroke-width="2"></circle>
          <text class="l-wait" x="293" y="40" fill="#F4F3F8" font-family="Archivo, sans-serif" font-size="12" font-weight="700" text-anchor="middle">Everyone waits for the kick</text>
          <text class="l-live" x="293" y="40" fill="#F5D90A" font-family="Archivo, sans-serif" font-size="12" font-weight="700" text-anchor="middle">Ball kicked: play is live</text>
          <text class="l-reset" x="293" y="214" fill="#7CC4EC" font-family="Archivo, sans-serif" font-size="12" font-weight="700" text-anchor="middle">White's fouls back to 0</text>
        </g>
      </svg>
      <figcaption>
        <span class="tf-badge">3rd foul: live</span>
        <span class="tf-title">The moment it is kicked</span>
        <span class="tf-text">The shooter kicks the ball from the halfway line. The moment it is kicked, everyone can chase it and regular play continues. The fouling team's count is back to 0.</span>
        <span class="tf-sum">Play on</span>
      </figcaption>
    </figure>
  </div>
  <button type="button" class="tf-toggle" data-anim-toggle>Pause animation</button>
</div>

<style>
  .tf {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }
  .tf-fig {
    margin: 0;
    border: 2px solid #3ca8e4;
    border-radius: 18px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #0f0f19;
  }
  .tf-svg {
    width: 100%;
    height: auto;
    display: block;
    background: #0e2a1c;
    border-radius: 14px;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tf-badge {
    display: inline-flex;
    align-self: flex-start;
    background: #3ca8e4;
    color: #0a0a12;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
  }
  .tf-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: 20px;
    color: #f4f3f8;
  }
  .tf-text {
    color: #c9c8d8;
    font-size: 15px;
    line-height: 1.5;
  }
  .tf-sum {
    color: #3ca8e4;
    font-weight: 800;
    font-size: 14px;
  }
  .tf-toggle {
    align-self: flex-start;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid #3a3a4d;
    background: transparent;
    color: #f4f3f8;
    font: inherit;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  .tf-toggle:hover {
    border-color: #f4f3f8;
  }

  /* ---- Animation ---- */
  .tf-svg * {
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
    animation-play-state: paused;
  }
  .tf-setup * { animation-duration: 9s; }
  .tf-live * { animation-duration: 7s; }
  .tf.is-running .tf-svg * {
    animation-play-state: running;
  }
  /* Reduced motion: hold each loop's final frame (the design) until Play. */
  .tf.is-still .tf-setup * { animation-delay: -8s; }
  .tf.is-still .tf-live * { animation-delay: -6s; }

  /* 1. Setup */
  .s-scene { animation-name: tf-scene; }
  .s-foul { animation-name: s-foul; }
  .s-shooter { animation-name: s-shooter; }
  .s-p1 { animation-name: s-p1; }
  .s-p2 { animation-name: s-p2; }
  .s-p3 { animation-name: s-p3; }
  .s-p4 { animation-name: s-p4; }
  .s-p5 { animation-name: s-p5; }
  .s-lineup { animation-name: s-lineup; }
  .s-arc, .s-open, .s-open-label { animation-name: s-open; }
  .s-shot { animation-name: s-shot; }

  @keyframes tf-scene {
    0% { opacity: 0; }
    3%, 93% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes s-foul {
    0%, 3% { opacity: 0; }
    7%, 26% { opacity: 1; }
    31%, 100% { opacity: 0; }
  }
  /* Players start spread out from the foul and walk to the halfway line. */
  @keyframes s-shooter {
    0%, 14% { transform: translate(-90px, 50px); }
    46%, 100% { transform: translate(0, 0); }
  }
  @keyframes s-p1 {
    0%, 15% { transform: translate(-58px, 38px); }
    44%, 100% { transform: translate(0, 0); }
  }
  @keyframes s-p2 {
    0%, 14% { transform: translate(112px, 22px); }
    48%, 100% { transform: translate(0, 0); }
  }
  @keyframes s-p3 {
    0%, 16% { transform: translate(-98px, 76px); }
    50%, 100% { transform: translate(0, 0); }
  }
  @keyframes s-p4 {
    0%, 15% { transform: translate(142px, 24px); }
    50%, 100% { transform: translate(0, 0); }
  }
  @keyframes s-p5 {
    0%, 17% { transform: translate(72px, -42px); }
    47%, 100% { transform: translate(0, 0); }
  }
  @keyframes s-lineup {
    0%, 49% { opacity: 0; }
    54%, 100% { opacity: 1; }
  }
  @keyframes s-open {
    0%, 52% { opacity: 0; }
    58%, 100% { opacity: 1; }
  }
  @keyframes s-shot {
    0%, 60% { opacity: 0; }
    66%, 100% { opacity: 1; }
  }

  /* 2. Live: the kick at 1.5s, then everyone chases (past the tips of their arrows). */
  .l-scene { animation-name: tf-scene; }
  .l-wait { animation-name: l-wait; }
  .l-live { animation-name: l-live; }
  .l-ball { animation-name: l-ball; }
  .l-ring { animation-name: l-ring; }
  .l-trail { animation-name: l-trail; }
  .l-shooter { animation-name: l-shooter; }
  .l-p2 { animation-name: l-p2; }
  .l-p3 { animation-name: l-p3; }
  .l-p4 { animation-name: l-p4; }
  .l-p5 { animation-name: l-p5; }
  .l-reset { animation-name: l-reset; }

  @keyframes l-wait {
    0%, 3% { opacity: 0; }
    6%, 21% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }
  @keyframes l-live {
    0%, 23% { opacity: 0; }
    27%, 100% { opacity: 1; }
  }
  @keyframes l-ball {
    0%, 22% { transform: translate(0, 0); animation-timing-function: ease-out; }
    38%, 100% { transform: translate(110px, -6px); }
  }
  @keyframes l-ring {
    0%, 37% { opacity: 0; }
    41%, 100% { opacity: 1; }
  }
  @keyframes l-trail {
    0%, 23% { opacity: 0; }
    30%, 100% { opacity: 1; }
  }
  @keyframes l-shooter {
    0%, 22% { transform: translate(0, 0); }
    50%, 100% { transform: translate(14px, -2px); }
  }
  @keyframes l-p2 {
    0%, 24% { transform: translate(0, 0); }
    56%, 100% { transform: translate(90px, 36px); }
  }
  @keyframes l-p3 {
    0%, 25% { transform: translate(0, 0); }
    58%, 100% { transform: translate(77px, 32px); }
  }
  @keyframes l-p4 {
    0%, 24% { transform: translate(0, 0); }
    56%, 100% { transform: translate(90px, -24px); }
  }
  @keyframes l-p5 {
    0%, 26% { transform: translate(0, 0); }
    58%, 100% { transform: translate(77px, -37px); }
  }
  @keyframes l-reset {
    0%, 44% { opacity: 0; }
    50%, 100% { opacity: 1; }
  }
</style>

<script>
  import { setupAnimatedDiagrams } from '../../../lib/diagramAnimation';
  setupAnimatedDiagrams();
</script>
