---
/** Hero for upcoming, live, postponed and cancelled tournaments (TurkeyTakedown.dc.html). */
import AutoplayVideo from '../AutoplayVideo.astro';
import SanityImage from '../SanityImage.astro';
import { dateRange, divisionsShort, splitLastWord } from '../../lib/format';
import { bestShoeLabel, presentedTitle, surfaceLabels, type Tournament } from '../../lib/tournaments';

interface Props {
  tournament: Tournament;
}

const { tournament: t } = Astro.props;
const [titleStart, titleEnd] = splitLastWord(t.title);
const surfacePill = [surfaceLabels(t.surface?.type).pill, bestShoeLabel(t.shoes)].filter(Boolean).join(' · ');
---

<section class="ev-hero">
  <AutoplayVideo
    src={t.heroVideo?.url}
    poster={t.heroVideo?.poster ?? t.heroImage ?? t.cardImage}
    eager
    sizes="100vw"
    class="ev-media"
  />
  <div aria-hidden="true" class="ev-shade"></div>
  <div class="wrap ev-body">
    <a href="/#tournaments" class="back">All tournaments</a>
    <SanityImage
      image={t.logo}
      maxWidth={1080}
      widths={[360, 540, 720, 1080]}
      sizes="(min-width: 900px) 260px, 100vw"
      loading="eager"
      class="hero-logo"
    />
    <div class="ev-title">
      <span class="eyebrow" style="color: var(--event-accent); font-size: 15px">{presentedTitle(t)}</span>
      <h1>
        {titleStart}<span style="color: var(--event)">{titleEnd}</span>
      </h1>
    </div>
    <ul class="pills" role="list">
      <li class="pill">{dateRange(t.startDate, t.endDate, { weekday: true })}</li>
      {t.venue?.name && <li class="pill">{t.venue.name}</li>}
      {t.divisions && <li class="pill">{divisionsShort(t.divisions)}</li>}
      {surfacePill && <li class="pill pill-event">{surfacePill}</li>}
    </ul>
  </div>
</section>

<style>
  .ev-hero {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
  }
  .ev-hero :global(.ev-media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
  }
  .ev-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 18, 0.2) 0%, rgba(10, 10, 18, 0.6) 50%, #0a0a12 100%);
  }
  .ev-body {
    position: relative;
    padding-top: 48px;
    padding-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-shadow: 0 1px 14px rgba(10, 10, 18, 0.65);
  }
  .back {
    font-weight: 700;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    align-self: flex-start;
  }
  .back:hover {
    color: var(--text);
  }
  .ev-body :global(.hero-logo) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.55));
  }
  @media (min-width: 900px) {
    .ev-body :global(.hero-logo) {
      position: absolute;
      top: 40px;
      right: 24px;
      width: 260px;
      margin: 0;
    }
  }
  .ev-title {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h1 {
    font-size: clamp(48px, 7vw, 96px);
    color: var(--text);
  }
  @media (min-width: 900px) {
    /* Leave room for the logo on the right. */
    .ev-title {
      padding-right: 280px;
    }
  }
  .pills {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    text-shadow: none;
  }
  .pill {
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(244, 243, 248, 0.12);
    font-weight: 700;
  }
  .pill-event {
    background: var(--event);
    color: var(--ink);
    font-weight: 800;
  }
</style>
