# Copy this file to .env and fill in the values. Never commit .env.

# Sanity project (public, safe to expose)
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Server only: a Sanity token with the Viewer role, used for draft preview.
# Create at sanity.io/manage > API > Tokens.
SANITY_API_READ_TOKEN=

# Server only: any random string of 32+ characters. Signs the preview cookie
# and lets preview requests skip Vercel's page cache.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERCEL_ISR_BYPASS_TOKEN=

# Only needed to run `npm run seed` (uploads the videos). Vercel > Storage > Blob.
BLOB_READ_WRITE_TOKEN=
